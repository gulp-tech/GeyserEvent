{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.vindicator": {
      "arrays": {
        "geometries": {
          "Array.geos": [ "Geometry.default", "Geometry.alien" ]
        },
        "textures": {
          "Array.skins": [ "Texture.default", "Texture.alien" ]
        }
      },
      "geometry": "Array.geos[query.model_scale < 0.88 || query.model_scale > 1.06]",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Array.skins[query.model_scale < 0.88 || query.model_scale > 1.06]" ]
    }
  }
}
