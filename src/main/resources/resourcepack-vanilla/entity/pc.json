{
  "format_version": "1.16.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ale:computer",
      "materials": {
	    "default": "entity_alphatest"
	  },
      "textures": {
        "default": "textures/entity/computer"
      },
      "geometry": {
        "default": "geometry.computer"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "animate": [
          "idle_controller",
          "move_controller",
          "attack_controller"
        ]
      },
      "animations": {
        "idle_controller": "controller.animation.idle",
        "attack_controller": "controller.animation.players.attack"
      },
      "spawn_egg": {
        "texture": "spawn_egg",
        "texture_index": 7
      },
      "render_controllers": [
        "controller.render.skeleton"

      ],
      "enable_attachables": true
    }
  }
}