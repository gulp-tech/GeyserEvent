{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:husk",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/ronaldo"
      },
      "geometry": {
        "default": "geometry.humanoid.custom"
      },
      "scripts": {
        "scale": "1.08",
        "initialize": [
          "variable.gliding_speed_value = 1.0;"
        ],
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "animate": [
          "look_at_target",
          "move",
          "attack",
          "bob"
        ]
      },
      "animations": {
        "look_at_target": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "attack": "animation.humanoid.attack.rotations",
        "bob": "animation.humanoid.bob"
      },
      "sound_effects": {
        "ambient": "ronaldo_siuu",
        "hurt": "ronaldo_siuu",
        "death": "ronaldo_siuu"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "enable_attachables": false
    }
  }
}
