{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:ghast",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/ghast/ghast",
        "shooting": "textures/entity/ghast/ghast_shooting",
        "nave": "textures/entity/nave"
      },
      "geometry": {
        "default": "geometry.ghast",
        "nave": "geometry.nave"
      },
      "scripts": {
        "pre_animation": [
          "variable.ge_ufo = query.model_scale < 0.70;"
        ],
        "animate": [
          { "nave": "variable.ge_ufo" },
          { "move": "!variable.ge_ufo" },
          { "scale": "!variable.ge_ufo" }
        ]
      },
      "animations": {
        "nave": "controller.animation.nave",
        "parado": "animation.nave.para",
        "andando": "animation.nave.anda",
        "abduzir": "animation.nave.abduzir",
        "move": "animation.ghast.move",
        "scale": "animation.ghast.scale"
      },
      "render_controllers": [
        "controller.render.ghast"
      ],
      "enable_attachables": false
    }
  }
}
