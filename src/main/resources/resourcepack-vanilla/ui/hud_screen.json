// GeyserEvent: панель активного ивента в правом верхнем углу экрана (Bedrock).
// Базовая техника и код: ofunny (https://ofunny.world/, github.com/ofunny/ofunnysBedrockExamples), GPL-3.0.
// Плагин шлёт action bar вида: #GE_R#|19:55~|3500/3500~|100 50 200
// При призыве босса: #GE_S#|01:59~|Осталось~|100 50 200 (отсчёт до появления).
//   (маркер ивента | время ММ:СС | статус | координаты; '~' — страж конца поля).
// Пока маркер есть, пак:
//   - прячет ванильный action bar (его alpha принудительно 0), и
//   - рисует карточку ивента на ванильном фоне textures/ui/hud_tip_text_background:
//     строка 1 — название ивента, строка 2 — статус и время, строка 3 — координаты.
// Разделение строк делает сам пак (моланг не умеет переносить '\n' из action bar):
// поля ASCII, поэтому операция '%.Ns' срабатывает одинаково и в символах, и в байтах,
// а '~' не даёт полсу совпасть со своим собственным началом.
// Тот же 'namespace': 'hud', что и у ванильного hud_screen.json — иначе фабрика
// hud_actionbar_text_factory и переменная $actionbar_text не находятся.
{
  "namespace": "hud",
  "geyserevent_hud_text": {
    "type": "image",
    "texture": "textures/ui/hud_tip_text_background",
    "size": [
      "100%c + 18px",
      "100%c + 12px"
    ],
    "layer": 31,
    "alpha": 1.0,
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [
      -4,
      4
    ],
    "controls": [
      {
        "geyserevent_card": {
          "type": "stack_panel",
          "orientation": "vertical",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            9,
            6
          ],
          "controls": [
            {
              "geyserevent_name_rift": {
                "type": "label",
                "text": "§cАДСКИЙ РАЗЛОМ",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_R#') != $raw)"
              }
            },
            {
              "geyserevent_name_excavation": {
                "type": "label",
                "text": "§eПЛЯЖНЫЕ РАСКОПКИ",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_E#') != $raw)"
              }
            },
            {
              "geyserevent_name_cauldron": {
                "type": "label",
                "text": "§dКОТЁЛ АЛХИМИКА",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_C#') != $raw)"
              }
            },
            {
              "geyserevent_name_summon": {
                "type": "label",
                "text": "§6ПРИЗЫВ БОССА",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_S#') != $raw)"
              }
            },
            {
              "geyserevent_status_rift": {
                "type": "label",
                "text": "$status_rift",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_R#') != $raw)"
              }
            },
            {
              "geyserevent_status_excavation": {
                "type": "label",
                "text": "$status_excavation",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_E#') != $raw)"
              }
            },
            {
              "geyserevent_status_cauldron": {
                "type": "label",
                "text": "$status_cauldron",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_C#') != $raw)"
              }
            },
            {
              "geyserevent_status_summon": {
                "type": "label",
                "text": "$status_summon",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left",
                "visible": "(($raw - '#GE_S#') != $raw)"
              }
            },
            {
              "geyserevent_coords": {
                "type": "label",
                "text": "$coords_line",
                "localize": false,
                "shadow": true,
                "layer": 32,
                "color": "$tool_tip_text",
                "text_alignment": "left"
              }
            }
          ]
        }
      }
    ],
    "$raw": "$actionbar_text",
    "$tail": "($raw - '#GE_R#|' - '#GE_E#|' - '#GE_C#|' - '#GE_S#|')",
    "$rest": "($tail - ('%.4s' * $tail + '|') - ('%.5s' * $tail + '|') - ('%.6s' * $tail + '|') - ('%.7s' * $tail + '|') - ('%.8s' * $tail + '|'))",
    "$time": "($tail - $rest - '|' - '~')",
    "$coords": "($rest - ('%.2s' * $rest + '|') - ('%.3s' * $rest + '|') - ('%.4s' * $rest + '|') - ('%.5s' * $rest + '|') - ('%.6s' * $rest + '|') - ('%.7s' * $rest + '|') - ('%.8s' * $rest + '|') - ('%.9s' * $rest + '|') - ('%.10s' * $rest + '|') - ('%.11s' * $rest + '|') - ('%.12s' * $rest + '|') - ('%.13s' * $rest + '|') - ('%.14s' * $rest + '|') - ('%.15s' * $rest + '|') - ('%.16s' * $rest + '|') - ('%.17s' * $rest + '|') - ('%.18s' * $rest + '|') - ('%.19s' * $rest + '|') - ('%.20s' * $rest + '|') - ('%.21s' * $rest + '|') - ('%.22s' * $rest + '|') - ('%.23s' * $rest + '|') - ('%.24s' * $rest + '|') - ('%.25s' * $rest + '|') - ('%.26s' * $rest + '|') - ('%.27s' * $rest + '|') - ('%.28s' * $rest + '|') - ('%.29s' * $rest + '|') - ('%.30s' * $rest + '|') - ('%.31s' * $rest + '|') - ('%.32s' * $rest + '|') - ('%.33s' * $rest + '|') - ('%.34s' * $rest + '|') - ('%.35s' * $rest + '|') - ('%.36s' * $rest + '|') - ('%.37s' * $rest + '|') - ('%.38s' * $rest + '|') - ('%.39s' * $rest + '|') - ('%.40s' * $rest + '|'))",
    "$status": "($rest - $coords - '|' - '~')",
    "$status_rift": "('§c❤ ' + $status + '  §7·§r  ' + '§f' + $time)",
    "$status_excavation": "('§eКисточка: §a' + $status + '  §7·§r  ' + '§f' + $time)",
    "$status_cauldron": "('§dРеагенты: §a' + $status + '  §7·§r  ' + '§f' + $time)",
    "$status_summon": "('§e' + $status + '  §7·§r  ' + '§f' + $time)",
    "$coords_line": "('§7Координаты: §f' + $coords)",
    "visible": "(($raw - '#GE_') != $raw)"
  },
  "geyserevent_hud_text_factory": {
    "type": "panel",
    "factory": {
      "name": "hud_actionbar_text_factory",
      "control_ids": {
        "hud_actionbar_text": "geyserevent_hud_text@hud.geyserevent_hud_text"
      }
    }
  },
  "hud_actionbar_text": {
    "type": "image",
    "size": [
      "100%c + 12px",
      "100%c + 5px"
    ],
    "offset": [
      0,
      "50%-68px"
    ],
    "texture": "textures/ui/hud_tip_text_background",
    "alpha": "((($actionbar_text - '#GE_') = $actionbar_text) ? @hud.anim_actionbar_text_background_alpha_out : 0)",
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "$tool_tip_text",
          "layer": 31,
          "text": "$actionbar_text",
          "localize": false,
          "alpha": "((($actionbar_text - '#GE_') = $actionbar_text) ? @hud.anim_actionbar_text_alpha_out : 0)"
        }
      }
    ]
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "geyserevent_hud_text_factory@hud.geyserevent_hud_text_factory": {}
          }
        ]
      }
    ]
  }
}
