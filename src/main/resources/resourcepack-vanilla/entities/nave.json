{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "ale:nave",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "nave": "controller.animation.nave",
        "nave2": "controller.animation.nave2"
      },
      "scripts": {
        "animate": [
          "nave",
          "nave2"
        ]
      }
    },
    "component_groups": {
      "no_alvo": {
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:behavior.random_hover": {
          "priority": 6,
          "interval": 1,
          "hover_height": [1, 16]
        },
           "minecraft:flying_speed": { "value": 0.26 },
           "minecraft:navigation.hover": {
               "avoid_damage_blocks": true,
               "can_path_from_air": true,
               "can_path_over_water": true,
               "can_sink": false
           },
           "minecraft:physics": { "has_gravity": false },
           "minecraft:can_fly": {},
           "minecraft:movement.hover": {}
     
                },
                "longe": {
                  "minecraft:variant": {
                    "value": 1
                  },
                  "minecraft:target_nearby_sensor": {
                    "inside_range": 2.0,

                    "on_inside_range": {
                      "event": "perto",
                      "target": "self"
                    }
                    
                  },
                     "minecraft:flying_speed": { "value": 0.26 },
                     "minecraft:navigation.hover": {
                         "avoid_damage_blocks": true,
                         "can_path_from_air": true,
                         "can_path_over_water": true,
                         "can_sink": false
                     },
                     "minecraft:physics": { "has_gravity": false },
                     "minecraft:can_fly": {},
                     "minecraft:movement.hover": {}
               
                          },

      "perto": {
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:target_nearby_sensor": {
   
          "outside_range": 6.0,
      
          "on_outside_range": {
            "event": "longe",
            "target": "self"
          }
         
        },/*
        "minecraft:can_fly": {},
        "minecraft:movement.hover": {},*/
        "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_from_air": false,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "is_amphibious": true
      },
      "minecraft:physics": { "has_gravity": true  }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [ "Aleexandre" ]
      },
      "minecraft:scale": {
        "value": 1.0
      },
      "minecraft:collision_box": {
        "width": 1.0,
        "height": 3.0
      },
      "minecraft:health": {
        "value": 200
      },
      "minecraft:movement": {
        "value": 0.40
      },
      "minecraft:jump.static": {},
      "minecraft:attack": {
      },
	  "minecraft:equipment": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/.json"
      },
      "minecraft:on_death": {
        "event": "minecraft:death",
        "target": "self"
      },
      "minecraft:behavior.melee_attack": {
        "priority": 5,
        "speed_multiplier": 1.5,
        "track_target": true,
        "reach_multiplier": 0.0

      },
    
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_rider",
                    "value": true
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  }
                ]
              },
              "event": "no_rider"
            }
          }]
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "pull_in_entities": false,
          "seats": [
            {
              "position": [0, 0, 0]
            }
          ]
        },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "Aleexandre"
                }
              ]
            },
            "max_dist": 32
          }
        ]
      },

      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:behavior.random_stroll": {
          "priority": 7,
          "speed_multiplier": 1
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
        "minecraft:timer": {
          "looping": true,
          "time": 2.0,
          "time_down_event": {
            "event": "timer",
            "target": "self"
          }
        }
    },
    "events": {
      "timer": {
        "run_command": {
          "command": [
            "ride @e[family=!inanimate,rm=0.1,r=2,type=!ale:alien,type=!ale:nave,type=!item,type=!xp_orb] start_riding @s teleport_rider"          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "longe"
          ]
        }
      },
      "perto": {
        "run_command": {
          "command": [
            "tp @s ~~~"
          ]
        },
        "add": {
          "component_groups": [
            "perto"
          ]
        },
        "remove": {
          "component_groups": [
            "longe"
          ]
        }
      },
      "longe": {
        "add": {
          "component_groups": [
            "longe"
          ]
        },
        "remove": {
          "component_groups": [
            "perto"
          ]
        }
      },
      "no_alvo": {
        "add": {
          "component_groups": [
            "no_alvo"
          ]
        },
        "remove": {
          "component_groups": [
            "perto", "longe"
          ]
        }
      },
      "no_rider": {
        "run_command": {
          "command": [
            "ride @p[r=2] stop_riding"
          ]
        }
      },
      "minecraft:death": {
        "run_command": {
          "command": [
            ""
          ]
        }
      }
    }
  }
}