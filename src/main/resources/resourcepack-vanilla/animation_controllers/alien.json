{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alien": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "blend_transition": 0.15,
          "animations": ["idle", "look"],
          "transitions": [
            { "attack": "query.attack_time > 0.0 || query.is_delayed_attacking" },
            { "walk": "query.modified_move_speed > 0.12" }
          ]
        },
        "walk": {
          "blend_transition": 0.12,
          "animations": ["walk", "look"],
          "transitions": [
            { "attack": "query.attack_time > 0.0 || query.is_delayed_attacking" },
            { "idle": "query.modified_move_speed <= 0.12" }
          ]
        },
        "attack": {
          "blend_transition": 0.08,
          "animations": ["attack", "look"],
          "transitions": [
            { "walk": "query.attack_time <= 0.0 && !query.is_delayed_attacking && query.modified_move_speed > 0.12" },
            { "idle": "query.attack_time <= 0.0 && !query.is_delayed_attacking && query.modified_move_speed <= 0.12" }
          ]
        }
      }
    }
  }
}
