{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ghast": {
      "arrays": {
        "geometries": {
          "Array.geos": [ "Geometry.default", "Geometry.nave" ]
        },
        "textures": {
          "Array.skins": [ "Texture.default", "Texture.nave" ]
        }
      },
      "geometry": "Array.geos[query.model_scale < 0.70]",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Array.skins[query.model_scale < 0.70]" ]
    }
  }
}
