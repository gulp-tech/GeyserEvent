{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:evoker",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/alien"
      },
      "geometry": {
        "default": "geometry.alien"
      },
      "scripts": {
        "initialize": [
          "variable.gliding_speed_value = 1.0;"
        ],
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed) * 57.3;"
        ],
        "animate": [
          "mob_controller",
          "attack_controller"
        ]
      },
      "animations": {
        "parado": "animation.me.parado",
        "andando": "animation.j.anda2",
        "correndo": "animation.prei.anda",
        "attack1": "animation.j.attack1",
        "attack2": "animation.j.attack2",
        "attack3": "animation.j.attack3",
        "attack_controller": "controller.animation.attack",
        "mob_controller": "controller.animation.mob_controller"
      },
      "render_controllers": [
        "controller.render.dano"
      ],
      "enable_attachables": false
    }
  }
}
